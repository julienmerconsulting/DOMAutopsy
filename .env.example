# Copier ce fichier en .env et remplir au moins une cle selon le provider voulu
# cp .env.example .env

# Pour --provider openai (defaut)
OPENAI_API_KEY=sk-...

# Pour --provider groq (compatible API OpenAI, plus rapide, gratuit jusqu'a un quota)
GROQ_API_KEY=gsk_...

# Bearer token pour proteger les endpoints qui mutent (POST/DELETE).
# Si commente / vide -> mode no-auth (dev local). Si set -> tout client doit
# envoyer 'Authorization: Bearer <token>'. WS et GET restent ouverts pour le
# partage des rapports/dashboards CI.
# DOMAUTOPSY_API_TOKEN=changeme-a-vraie-valeur-aleatoire-32-chars-min
