# Outputs de run - tout est dans runs/<timestamp>_<runid>/ depuis la v0 web
runs/

# Patterns historiques - anciens artefacts en RACINE uniquement (le prefixe / est
# essentiel : sans lui, `test_*.py` matcherait recursivement toute la suite
# tests/test_*.py qui est LEGITIME et doit etre versionnee).
/locator_log_*.json
/locator_dedup_*.json
/clean_steps_*.json
/katalon_test_*.groovy
/test_*.groovy
/test_*.spec.ts
/test_*.cy.js
/test_*.py
/qa_report_*.html
/_temp_scenario.json
*.bak
# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Env
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Node / Playwright runtime (installes localement par npm install)
# package-lock.json est INTENTIONNELLEMENT versionne : garantit npm ci reproductible.
node_modules/
playwright-report/
test-results/
.playwright/

# Runtime autonome telecharge par `python domautopsy_cli.py runtime install`
# (Node.exe + @playwright/test + Chromium ~200MB au total, JAMAIS committes).
# Le code d'install lui-meme (runtime_installer.py) reste versionne.
runtime/
